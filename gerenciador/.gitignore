# Indico quais arquivos locais ou gerados deixo fora do controle de versão.

# Excluo as dependências instaladas, pois posso recuperá-las com o npm.
node_modules/

# Mantenho fora do Git os dados locais do Expo e os resultados de exportação.
.expo/
dist/
web-build/
expo-env.d.ts

# Evito versionar caches nativos, cópias temporárias e arquivos de assinatura.
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Descarto os arquivos temporários usados na verificação do Metro.
.metro-health-check*

# Ignoro relatórios locais de execução dos gerenciadores de pacotes.
npm-debug.*
yarn-debug.*
yarn-error.*

# Retiro metadados do macOS e arquivos PEM que podem conter chaves ou certificados.
.DS_Store
*.pem

# Preservo as configurações particulares do ambiente fora do repositório.
.env*.local

# Excluo o cache incremental do TypeScript caso alguma ferramenta o gere.
*.tsbuildinfo

# Deixo de versionar as pastas nativas geradas a partir da configuração Expo.
/ios
/android
